&CONTROL
    calculation = 'scf'
    prefix      = 'SnS2.2x2.hex.biaxial_3p0.scf'
    outdir      = './work/biaxial_3p0/scf'
    pseudo_dir  = '../../../../../pp'
    tstress     = .true.
    tprnfor     = .true.
    disk_io     = 'low'
/

&SYSTEM
    ibrav       = 0
    nat         = 12
    ntyp        = 2
    degauss     = 1.0d-02
    ecutwfc     = 80
    ecutrho     = 400
    occupations = 'smearing'
    smearing    = 'cold'
/

&ELECTRONS
    conv_thr        = 1.0d-6
    mixing_beta     = 0.60
    electron_maxstep = 100
/

