&CONTROL
    calculation = 'relax'
    prefix      = 'SnS2.2x2.hex.biaxial_1p0.relax'
    outdir      = './work/biaxial_1p0/relax'
    pseudo_dir  = '../../../../../pp'
    tstress     = .true.
    tprnfor     = .true.
    disk_io     = 'low'
/

&SYSTEM
    ibrav       = 0
    nat         = 12
    ntyp        = 2
    degauss     = 1.0d-02
    ecutwfc     = 60
    ecutrho     = 520
    occupations = 'smearing'
    smearing    = 'cold'
/

&ELECTRONS
    conv_thr        = 1.0d-6
    mixing_beta     = 0.60
    electron_maxstep = 100
/

&IONS
    ion_dynamics = 'bfgs'
/

